# Supabase — project URL and keys from Project Settings → API.
# Use the legacy anon JWT, not an sb_publishable_... key: @supabase/ssr 0.12
# parses the key as a JWT and the middleware throws in the edge runtime.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS — never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# AI providers. Both are read only inside Route Handlers, never on the client.

# Claude, reached through OpenRouter's OpenAI-compatible API. Used for parsing
# free text and reading receipt photos. The only AI credential this app needs:
# speech is dictated by the user's own keyboard into the text field, so there
# is no transcription service to pay for.
OPENROUTER_API_KEY=

# Absolute URL of this deployment, used for auth redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Only needed to run tests/e2e — two fixture accounts (create them once via
# /signup) and the password they share. Never given a default in source: see
# tests/e2e/credentials.ts for why.
E2E_EMAIL=alpha@testmail.dev
E2E_ONBOARDING_EMAIL=beta@testmail.dev
E2E_PASSWORD=
